{
  "name": "nanos-lint",
  "version": "1.0.0",
  "description": "Linter and type-checker for nanos world Lua scripts powered by LuaLS",
  "keywords": [
    "nanos-world",
    "lua",
    "luals",
    "lua-language-server",
    "linter",
    "type-checker",
    "github-actions"
  ],
  "author": "Voltaism",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vugi99/nanos-lint.git"
  },
  "bugs": {
    "url": "https://github.com/vugi99/nanos-lint/issues"
  },
  "homepage": "https://github.com/vugi99/nanos-lint#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nanos-lint": "./bin/nanos-lint.js"
  },
  "files": [
    "bin",
    "dist",
    "definitions",
    "templates",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" --fix --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-annotations": "tsx scripts/sync-annotations.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@*": true
  }
}
