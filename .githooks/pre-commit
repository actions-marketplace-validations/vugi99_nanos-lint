#!/usr/bin/env sh

# Project Quality Gates Pre-Commit Hook
#
# 1. Check code formatting with Prettier (format:check)
# 2. Lint the codebase (lint, 0 errors and 0 warnings)
# 3. Check architecture and dependency boundaries (lint:deps)
# 4. Check comment density limit (lint:comments)
# 5. Check docstring coverage (lint:docstrings)
# 6. Type-check TypeScript (typecheck, 0 type errors)
# 7. Build distribution bundle (build)
# 8. Run all Vitest unit and live LuaLS integration tests (test:coverage, 100% passing)

set -e

# Resolve npm command (support both unix and Windows environments)
NPM_CMD="npm"
if ! command -v "$NPM_CMD" >/dev/null 2>&1; then
  if command -v npm.cmd >/dev/null 2>&1; then
    NPM_CMD="npm.cmd"
  fi
fi

echo "[pre-commit] Running project quality gates ($NPM_CMD run gates)..."
$NPM_CMD run gates

echo "[pre-commit] All project quality gates passed successfully!"

