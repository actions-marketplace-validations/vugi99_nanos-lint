#!/usr/bin/env sh

# Project Quality Gates Pre-Commit Hook
#
# 1. Lint the codebase (must have 0 errors and 0 warnings)
# 2. Type-check TypeScript (must produce 0 type errors)
# 3. Build distribution bundle
# 4. Run all Vitest unit and live LuaLS integration tests (must be 100% passing)

set -e

# Resolve npm command (support both unix and Windows environments)
NPM_CMD="npm"
if ! command -v "$NPM_CMD" >/dev/null 2>&1; then
  if command -v npm.cmd >/dev/null 2>&1; then
    NPM_CMD="npm.cmd"
  fi
fi

echo "[pre-commit] Running project quality gates..."

echo "[pre-commit] 1/4: Linting codebase ($NPM_CMD run lint)..."
$NPM_CMD run lint

echo "[pre-commit] 2/4: Typechecking TypeScript ($NPM_CMD run typecheck)..."
$NPM_CMD run typecheck

echo "[pre-commit] 3/4: Building distribution bundle ($NPM_CMD run build)..."
$NPM_CMD run build

echo "[pre-commit] 4/4: Running Vitest test suite with coverage ($NPM_CMD run test:coverage)..."
$NPM_CMD run test:coverage

echo "[pre-commit] All project quality gates passed successfully!"

