{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.4",
    "path": [
      "?.lua",
      "Shared/?.lua",
      "Client/?.lua",
      "Server/?.lua"
    ],
    "special": {
      "Package.Require": "require"
    }
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": [
      ".git",
      ".vscode",
      ".nanos-lint",
      "node_modules",
      "dist",
      "bin",
      "vendor",
      "script",
      "meta",
      "locale",
      "log"
    ],
    "library": []
  },
  "files": {
    "exclude": [
      ".nanos-lint/**"
    ]
  },
  "diagnostics": {
    "enable": true,
    "neededFileStatus": {
      "unused-local": "Any",
      "redefined-local": "Any"
    },
    "severity": {
      "redefined-local": "Warning",
      "unused-local": "Warning",
      "unused-vararg": "Warning"
    }
  }
}
