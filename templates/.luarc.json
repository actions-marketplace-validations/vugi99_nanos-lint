{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.4",
    "path": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": [
      ".git",
      ".vscode",
      ".nanos-lint",
      "node_modules",
      "dist",
      "bin",
      "vendor",
      "script",
      "meta",
      "locale",
      "log"
    ],
    "library": []
  },
  "files": {
    "exclude": [
      ".nanos-lint/**"
    ]
  },
  "diagnostics": {
    "enable": true,
    "globals": [
      "Package",
      "Server",
      "Client",
      "Events",
      "Assets",
      "Trace",
      "Timer",
      "HTTP",
      "File",
      "Database"
    ],
    "severity": {
      "param-type-mismatch": "Warning",
      "cast-type-mismatch": "Warning",
      "undefined-field": "Warning",
      "undefined-global": "Warning",
      "syntax-error": "Error"
    }
  }
}

